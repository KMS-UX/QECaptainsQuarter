{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "assets/data/**",
              "components/core/**",
              "components/dialogue/**",
              "components/equipment/**",
              "components/hud/**",
              "components/inventory/**",
              "components/quantum/**",
              "components/quests/**",
              "components/system/**",
              "ui_kits/game/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Orbitron|Share Tech Mono))/i]",
        "message": "Font not provided by the design system. Available: Orbitron, Share Tech Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|disabled|onClick|children|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, disabled, onClick, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost|danger)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DialogueBox'] > JSXAttribute > JSXIdentifier[name!=/^(?:kind|speaker|portrait|children|actions|style|key|ref|className|style|children)$/]",
        "message": "<DialogueBox> doesn't accept that prop. Declared props: kind, speaker, portrait, children, actions, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='DialogueBox'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:dialogue|system|warning|confirm)$/]",
        "message": "<DialogueBox> kind must be one of 'dialogue' | 'system' | 'warning' | 'confirm'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ElementCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|element|rarity|source|usage|description|width|style|key|ref|className|style|children)$/]",
        "message": "<ElementCard> doesn't accept that prop. Declared props: name, element, rarity, source, usage, description, width, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ElementCard'] > JSXAttribute[name.name='element'] > Literal[value!=/^(?:quantium|voidium|neutronite|singularium|phasium|entropium|aeon)$/]",
        "message": "<ElementCard> element must be one of 'quantium' | 'voidium' | 'neutronite' | 'singularium' | 'phasium' | 'entropium' | 'aeon'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ItemSlot'] > JSXAttribute > JSXIdentifier[name!=/^(?:rarity|icon|image|count|quality|badge|selected|size|empty|onClick|style|key|ref|className|style|children)$/]",
        "message": "<ItemSlot> doesn't accept that prop. Declared props: rarity, icon, image, count, quality, badge, selected, size, empty, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ItemSlot'] > JSXAttribute[name.name='rarity'] > Literal[value!=/^(?:common|uncommon|rare|epic|legendary|mythic|exotic)$/]",
        "message": "<ItemSlot> rarity must be one of 'common' | 'uncommon' | 'rare' | 'epic' | 'legendary' | 'mythic' | 'exotic'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ItemSlot'] > JSXAttribute[name.name='badge'] > Literal[value!=/^(?:new|favorite|equipped|locked)$/]",
        "message": "<ItemSlot> badge must be one of 'new' | 'favorite' | 'equipped' | 'locked'."
      },
      {
        "selector": "JSXOpeningElement[name.name='LoadingScreen'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|progress|status|tip|width|style|key|ref|className|style|children)$/]",
        "message": "<LoadingScreen> doesn't accept that prop. Declared props: title, progress, status, tip, width, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='MenuList'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|selected|onSelect|width|key|ref|className|style|children)$/]",
        "message": "<MenuList> doesn't accept that prop. Declared props: items, selected, onSelect, width."
      },
      {
        "selector": "JSXOpeningElement[name.name='MinimapBlip'] > JSXAttribute > JSXIdentifier[name!=/^(?:kind|x|y|key|ref|className|style|children)$/]",
        "message": "<MinimapBlip> doesn't accept that prop. Declared props: kind, x, y."
      },
      {
        "selector": "JSXOpeningElement[name.name='MinimapBlip'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:player|ally|enemy|objective|poi)$/]",
        "message": "<MinimapBlip> kind must be one of 'player' | 'ally' | 'enemy' | 'objective' | 'poi'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Notification'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|style|key|ref|className|style|children)$/]",
        "message": "<Notification> doesn't accept that prop. Declared props: items, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Objective'] > JSXAttribute > JSXIdentifier[name!=/^(?:text|done|count|key|ref|className|style|children)$/]",
        "message": "<Objective> doesn't accept that prop. Declared props: text, done, count."
      },
      {
        "selector": "JSXOpeningElement[name.name='Panel'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|accent|corners|children|style|key|ref|className|style|children)$/]",
        "message": "<Panel> doesn't accept that prop. Declared props: title, accent, corners, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='QuestCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:tier|title|description|objective|progress|progressMax|level|image|footer|width|style|key|ref|className|style|children)$/]",
        "message": "<QuestCard> doesn't accept that prop. Declared props: tier, title, description, objective, progress, progressMax, level, image, footer, width, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='QuestCard'] > JSXAttribute[name.name='tier'] > Literal[value!=/^(?:main|side|faction|world|daily|hidden)$/]",
        "message": "<QuestCard> tier must be one of 'main' | 'side' | 'faction' | 'world' | 'daily' | 'hidden'."
      },
      {
        "selector": "JSXOpeningElement[name.name='RewardItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|rarity|image|key|ref|className|style|children)$/]",
        "message": "<RewardItem> doesn't accept that prop. Declared props: name, rarity, image."
      },
      {
        "selector": "JSXOpeningElement[name.name='RewardItem'] > JSXAttribute[name.name='rarity'] > Literal[value!=/^(?:common|uncommon|rare|epic|legendary|mythic|exotic)$/]",
        "message": "<RewardItem> rarity must be one of 'common' | 'uncommon' | 'rare' | 'epic' | 'legendary' | 'mythic' | 'exotic'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TrackedQuest'] > JSXAttribute > JSXIdentifier[name!=/^(?:tier|title|sub|timer|active|key|ref|className|style|children)$/]",
        "message": "<TrackedQuest> doesn't accept that prop. Declared props: tier, title, sub, timer, active."
      },
      {
        "selector": "JSXOpeningElement[name.name='TrackedQuest'] > JSXAttribute[name.name='tier'] > Literal[value!=/^(?:main|side|faction|world|daily|hidden)$/]",
        "message": "<TrackedQuest> tier must be one of 'main' | 'side' | 'faction' | 'world' | 'daily' | 'hidden'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:kind|value|max|label|showValue|height|style|key|ref|className|style|children)$/]",
        "message": "<StatBar> doesn't accept that prop. Declared props: kind, value, max, label, showValue, height, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatBar'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:hp|ep|xp|boss)$/]",
        "message": "<StatBar> kind must be one of 'hp' | 'ep' | 'xp' | 'boss'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatMeter'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|color|showValue|width|style|key|ref|className|style|children)$/]",
        "message": "<StatMeter> doesn't accept that prop. Declared props: label, value, color, showValue, width, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tabs'] > JSXAttribute > JSXIdentifier[name!=/^(?:tabs|active|onChange|key|ref|className|style|children)$/]",
        "message": "<Tabs> doesn't accept that prop. Declared props: tabs, active, onChange."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
